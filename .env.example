# ---------------------------------------------------------------------------
# UEBA platform — local secrets and overrides
#
#   cp .env.example .env     and fill in the values you need.
#
# .env is git-ignored.  Nothing in here is ever written back to the repository.
# Every variable also works as a plain environment variable, so systemd or
# Docker can supply them instead.
# ---------------------------------------------------------------------------

# --- LLM triage (optional) -------------------------------------------------
# Alerts are always created by local rules.  The LLM is a post-hoc second
# opinion that can only raise an alert's severity, never create or drop one.

# Turn triage on (default: off).
LLM_ENABLED=false

# Anthropic is the default provider.  Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model and reasoning depth.  Depth is low | medium | high | xhigh | max.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# To use a different provider instead, set provider + base URL + key, e.g.
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=llama3.1
# or any other OpenAI-compatible endpoint:
#   LLM_PROVIDER=openai
#   LLM_API_KEY=
# LLM_PROVIDER=anthropic

# Optional secondary provider, tried when the primary errors out.
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=

# --- API authentication ----------------------------------------------------
# REQUIRED in production: any long random string. Signs the dashboard's JWTs.
#   openssl rand -hex 32
JWT_SECRET=

# --- Pi-hole DNS ingestion (optional) --------------------------------------
# Comma-separated list of Pi-hole v6 base URLs, and the shared web password.
# PIHOLE_URL=http://192.168.1.10,http://192.168.1.11
# PIHOLE_PASSWORD=

# --- Alert escalation (optional) -------------------------------------------
# Webhook that receives escalated alerts (Slack, Discord, ntfy, ...).
# ESCALATION_WEBHOOK_URL=

# --- Network topology ------------------------------------------------------
# These mirror the `network:` block in backend/config.yaml.  Setting them here
# wins over the YAML, which is handy for containers.  Comma-separated lists.
# UEBA_NETWORK_NAME=LAN
# UEBA_LAN_CIDRS=192.168.1.0/24
# UEBA_GATEWAY_IPS=192.168.1.1
# UEBA_DNS_SERVERS=192.168.1.10,192.168.1.11
# UEBA_INFRA_HOSTS=
# UEBA_DNS_BURST_WHITELIST=
# UEBA_OWN_HOSTNAMES=
# UEBA_SEARXNG_URLS=http://192.168.1.10:8080
# UEBA_WAN_IPS=

# --- Paths and listeners ---------------------------------------------------
# UEBA_DB_PATH=backend/data/ueba.db
# UEBA_DATA_DIR=backend/data
# SYSLOG_PORT=1514
# API_HOST=0.0.0.0
# API_PORT=28819
# LOG_LEVEL=INFO

# --- Threat feeds ----------------------------------------------------------
# Optional local SQLite mirror of CVE / EPSS / Tranco data (docs/FEEDS.md).
# FEEDS_LOCAL_DB_PATH=
