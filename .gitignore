# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets.json

# ---------------------------------------------------------------------------
# Runtime data
# ---------------------------------------------------------------------------
backend/data/*
!backend/data/README.md
!backend/data/geoip/
backend/data/geoip/*
!backend/data/geoip/.gitkeep

# GeoIP databases (large, separately licensed — see docs/GEOIP.md)
*.mmdb

# Databases and write-ahead logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Persisted models
*.joblib
*.pkl
*.h5

# ---------------------------------------------------------------------------
# Node / Angular
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.angular/
frontend/tmp/
frontend/out-tsc/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Logs and editors
# ---------------------------------------------------------------------------
*.log
logs/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
